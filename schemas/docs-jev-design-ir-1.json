{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "docs-jev-design-ir-1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "category"],
  "properties": {
    "schema_version": {"const": "docs-jev-design-ir-1"},
    "category": {"enum": ["information_priority", "readability_proxies", "visual_hierarchy_structure", "claim_support", "comparison_semantics", "connector_meaning", "misinterpretation_risk"]},
    "elements": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/element"}},
    "regions": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/element"}},
    "relations": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/relation"}},
    "measurements": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/measurement"}},
    "metrics": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/measurement"}},
    "priority_order": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "hierarchy": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/relation"}},
    "levels": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/relation"}},
    "claims": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/relation"}},
    "support": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/relation"}},
    "comparisons": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/relation"}},
    "connectors": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/relation"}},
    "risks": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/risk"}},
    "misinterpretation_risks": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/risk"}},
    "provenance": {"$ref": "#/$defs/provenance"},
    "source_identity": {"$ref": "#/$defs/identity"},
    "artifact_identity": {"$ref": "#/$defs/identity"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "number": {"type": "number"},
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "role": {"type": "string", "minLength": 1, "maxLength": 64},
        "kind": {"type": "string", "minLength": 1, "maxLength": 64},
        "page": {"type": "integer", "minimum": 1},
        "page_index": {"type": "integer", "minimum": 0},
        "bbox_pdf_points": {"type": "array", "prefixItems": [{"$ref": "#/$defs/number"}, {"$ref": "#/$defs/number"}, {"$ref": "#/$defs/number"}, {"$ref": "#/$defs/number"}], "minItems": 4, "maxItems": 4},
        "dimensions_pt": {"type": "array", "prefixItems": [{"$ref": "#/$defs/number"}, {"$ref": "#/$defs/number"}], "minItems": 2, "maxItems": 2},
        "units": {"const": "pt"},
        "measurement_basis": {"type": "string", "minLength": 1, "maxLength": 64},
        "order": {"type": "integer", "minimum": 0},
        "source_order": {"type": "integer", "minimum": 0},
        "level": {"type": "integer", "minimum": 0},
        "priority_rank": {"type": "integer", "minimum": 0},
        "importance": {"type": "number", "minimum": 0},
        "weight": {"type": "number", "minimum": 0},
        "font_size_pt": {"type": "number", "exclusiveMinimum": 0},
        "line_height_pt": {"type": "number", "exclusiveMinimum": 0},
        "contrast_ratio": {"type": "number", "minimum": 0},
        "known_occlusion": {"type": ["boolean", "null"]}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"type": "string", "minLength": 1, "maxLength": 64},
        "type": {"type": "string", "minLength": 1, "maxLength": 64},
        "source_id": {"$ref": "#/$defs/id"},
        "target_id": {"$ref": "#/$defs/id"},
        "target_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "from_id": {"$ref": "#/$defs/id"},
        "to_id": {"$ref": "#/$defs/id"},
        "to_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "left_id": {"$ref": "#/$defs/id"},
        "right_id": {"$ref": "#/$defs/id"},
        "support_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "relation_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "meaning": {"type": "string", "minLength": 1, "maxLength": 64},
        "relation": {"type": "string", "minLength": 1, "maxLength": 64},
        "axis": {"type": "string", "minLength": 1, "maxLength": 64},
        "claim_kind": {"type": "string", "minLength": 1, "maxLength": 64},
        "risk_kind": {"type": "string", "minLength": 1, "maxLength": 64},
        "severity": {"enum": ["low", "medium", "high"]},
        "priority_rank": {"type": "integer", "minimum": 0},
        "level": {"type": "integer", "minimum": 0},
        "score": {"type": "number"},
        "ratio": {"type": "number", "minimum": 0},
        "declared": {"type": "boolean"}
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"type": "string", "minLength": 1, "maxLength": 64},
        "units": {"const": "pt"},
        "measurement_basis": {"type": "string", "minLength": 1, "maxLength": 64},
        "font_size_pt": {"type": "number", "exclusiveMinimum": 0},
        "line_height_pt": {"type": "number", "exclusiveMinimum": 0},
        "baseline_distance_pt": {"type": "number", "minimum": 0},
        "paragraph_gap_pt": {"type": "number", "minimum": 0},
        "inner_margin_pt": {"type": "number", "minimum": 0},
        "outer_margin_pt": {"type": "number", "minimum": 0},
        "gap_pt": {"type": "number", "minimum": 0},
        "overlap_pt": {"type": "number", "minimum": 0},
        "contrast_ratio": {"type": "number", "minimum": 0},
        "line_count": {"type": "integer", "minimum": 0},
        "count": {"type": "integer", "minimum": 0},
        "source_id": {"$ref": "#/$defs/id"},
        "target_id": {"$ref": "#/$defs/id"}
      }
    },
    "risk": {
      "allOf": [{"$ref": "#/$defs/relation"}, {"type": "object", "properties": {"risk_kind": {"type": "string", "minLength": 1, "maxLength": 64}, "severity": {"enum": ["low", "medium", "high"]}}}]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {"kind": {"type": "string", "minLength": 1, "maxLength": 64}, "id": {"$ref": "#/$defs/id"}}
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "id": {"$ref": "#/$defs/id"}}
    }
  }
}
