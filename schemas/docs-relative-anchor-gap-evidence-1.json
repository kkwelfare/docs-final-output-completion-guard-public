{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "docs-relative-anchor-gap-evidence-1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "execution_identity", "annotation_id", "source", "artifact", "format", "requested", "applied", "effective", "evidence_sha256"],
  "properties": {
    "schema_version": {"const": "docs-relative-anchor-gap-evidence-1"},
    "execution_identity": {"$ref": "#/$defs/identity"},
    "annotation_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "source": {"$ref": "#/$defs/handle"},
    "artifact": {"$ref": "#/$defs/handle"},
    "format": {"enum": ["svg", "pptx", "pdf", "png"]},
    "requested": {"$ref": "docs-relative-anchor-gap-contract-1.json#/$defs/policy"},
    "applied": {"$ref": "#/$defs/applied"},
    "effective": {"$ref": "#/$defs/effective"},
    "evidence_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity": {"type": "object", "additionalProperties": false, "required": ["contract_id", "policy_hash", "producer_run_id", "artifact_set_id"], "properties": {"contract_id": {"$ref": "#/$defs/hash"}, "policy_hash": {"$ref": "#/$defs/hash"}, "producer_run_id": {"type": "integer", "minimum": 0}, "artifact_set_id": {"$ref": "#/$defs/hash"}}},
    "handle": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^/"}, "sha256": {"$ref": "#/$defs/hash"}}},
    "point": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2},
    "bbox": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}], "minItems": 4, "maxItems": 4},
    "applied": {"type": "object", "additionalProperties": false, "required": ["format", "adapter", "anchor_primitive_id", "reference_primitive_id", "source_evidence_sha256"], "properties": {"format": {"enum": ["svg", "pptx", "pdf", "png"]}, "adapter": {"type": "string", "minLength": 1}, "anchor_primitive_id": {"type": "string", "minLength": 1}, "reference_primitive_id": {"type": "string", "minLength": 1}, "source_evidence_sha256": {"$ref": "#/$defs/hash"}}},
    "effective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurement_basis", "tail_tip_pdf_points", "avatar_bbox_pdf_points", "avatar_width_pt", "direction_vector", "gap_pt", "gap_ratio", "target_gap_ratio", "tolerance", "facing", "no_contact", "contact_distance_pt", "status", "failed_constraints"],
      "properties": {
        "measurement_basis": {"enum": ["pdf_vector_plus_render_mask", "pdf_render_mask", "png_alpha_mask"]},
        "tail_tip_pdf_points": {"$ref": "#/$defs/point"}, "avatar_bbox_pdf_points": {"$ref": "#/$defs/bbox"},
        "avatar_width_pt": {"type": "number", "exclusiveMinimum": 0}, "direction_vector": {"$ref": "#/$defs/point"},
        "gap_pt": {"type": "number"}, "gap_ratio": {"type": "number"}, "target_gap_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "tolerance": {"type": "number", "minimum": 0, "maximum": 1}, "facing": {"enum": ["toward_anchor", "away_from_anchor", "neutral"]},
        "no_contact": {"type": "boolean"}, "contact_distance_pt": {"type": "number", "minimum": 0},
        "status": {"enum": ["pass", "fail", "ambiguous"]}, "failed_constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "artifact_path": {"type": "string", "pattern": "^/"}, "artifact_sha256": {"$ref": "#/$defs/hash"},
        "pixel_sha256": {"$ref": "#/$defs/hash"}, "points_per_pixel": {"type": "number", "exclusiveMinimum": 0},
        "page": {"type": "integer", "minimum": 1}, "render_scale": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
