{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity": {"type": "object", "additionalProperties": false, "required": ["contract_id", "policy_hash", "producer_run_id", "artifact_set_id"], "properties": {"contract_id": {"$ref": "#/$defs/hash"}, "policy_hash": {"$ref": "#/$defs/hash"}, "producer_run_id": {"type": "integer", "minimum": 0}, "artifact_set_id": {"$ref": "#/$defs/hash"}}},
    "outcome": {"type": "object", "additionalProperties": false, "required": ["rule_id", "status"], "properties": {"rule_id": {"enum": ["AQ-CONTRAST-01", "AQ-LEGIBILITY-01", "AQ-PRINT-01", "AQ-HIERARCHY-01", "AQ-VISUAL-01"]}, "status": {"enum": ["pass", "HARD_FAIL", "REVIEW_CANDIDATE", "NOT_VERIFIED", "NOT_APPLICABLE"]}}},
    "contrast": {"type": "object", "additionalProperties": false, "required": ["foreground_pixel_count", "background_sample_count", "min", "p05", "median"], "properties": {"foreground_pixel_count": {"type": "integer", "minimum": 1}, "background_sample_count": {"type": "integer", "minimum": 1}, "min": {"type": "number", "minimum": 1, "maximum": 21}, "p05": {"type": "number", "minimum": 1, "maximum": 21}, "median": {"type": "number", "minimum": 1, "maximum": 21}}},
    "variant_measurement": {"type": "object", "additionalProperties": false, "required": ["region_id", "status", "reason", "contrast"], "properties": {"region_id": {"type": "string", "minLength": 1}, "status": {"enum": ["pass", "HARD_FAIL", "NOT_VERIFIED"]}, "reason": {"type": ["string", "null"]}, "contrast": {"anyOf": [{"$ref": "#/$defs/contrast"}, {"type": "null"}]}}},
    "variant": {"type": "object", "additionalProperties": false, "required": ["kind", "scale", "path", "sha256", "width", "height", "pixel_sha256", "render_index", "measurements"], "properties": {"kind": {"enum": ["native", "grayscale", "scale"]}, "scale": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "path": {"type": "string", "pattern": "^/"}, "sha256": {"$ref": "#/$defs/hash"}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}, "pixel_sha256": {"$ref": "#/$defs/hash"}, "render_index": {"type": "integer", "minimum": 1}, "measurements": {"type": "array", "items": {"$ref": "#/$defs/variant_measurement"}}}}
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "execution_identity", "policy_hash", "rollout_mode", "required_evidence", "artifact_path", "artifact_sha256", "outcomes", "regions", "variants", "HARD_FAIL", "NOT_VERIFIED", "REVIEW_CANDIDATE", "review_disposition", "model_invoked_on_hard_fail_path"],
  "properties": {
    "schema_version": {"const": "docs-rendered-readability-receipt-1"},
    "execution_identity": {"$ref": "#/$defs/identity"},
    "policy_hash": {"$ref": "#/$defs/hash"},
    "rollout_mode": {"enum": ["shadow", "enforced"]},
    "required_evidence": {"type": "boolean"},
    "artifact_path": {"type": "string", "pattern": "^/"},
    "artifact_sha256": {"$ref": "#/$defs/hash"},
    "outcomes": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/outcome"}},
    "regions": {"type": "array", "items": {"type": "object"}},
    "variants": {"type": "array", "items": {"$ref": "#/$defs/variant"}},
    "HARD_FAIL": {"type": "array", "items": {"type": "object"}},
    "NOT_VERIFIED": {"type": "array", "items": {"type": "object"}},
    "REVIEW_CANDIDATE": {"type": "array", "items": {"type": "object"}},
    "review_disposition": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^/"}, "sha256": {"$ref": "#/$defs/hash"}}}]},
    "model_invoked_on_hard_fail_path": {"const": false}
  }
}
