{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "artifact_path", "artifact_sha256", "scan_path", "scan_sha256", "producer_task_id", "producer_run_id", "reviewer_task_id", "reviewer_run_id", "reviewer_role", "artifact_set_id", "candidate_set_digest", "llm_invoked", "vision_invoked", "reviews"],
  "properties": {
    "schema_version": {"const": "docs-layout-visual-review-2"},
    "status": {"enum": ["pass", "block"]},
    "artifact_path": {"type": "string", "pattern": "^/"},
    "artifact_sha256": {"$ref": "#/$defs/hash"},
    "scan_path": {"type": "string", "pattern": "^/"},
    "scan_sha256": {"$ref": "#/$defs/hash"},
    "producer_task_id": {"type": "string", "minLength": 1},
    "producer_run_id": {"type": "integer", "minimum": 0},
    "reviewer_task_id": {"type": "string", "minLength": 1},
    "reviewer_run_id": {"type": "integer", "minimum": 0},
    "reviewer_role": {"type": "string", "minLength": 1},
    "artifact_set_id": {"$ref": "#/$defs/hash"},
    "candidate_set_digest": {"$ref": "#/$defs/hash"},
    "llm_invoked": {"const": false},
    "vision_invoked": {"const": false},
    "reviews": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["issue_id", "rule", "status", "disposition", "rationale_code", "llm_invoked", "vision_invoked"],
        "properties": {
          "issue_id": {"type": "string", "minLength": 1},
          "rule": {"type": "string", "minLength": 1},
          "status": {"enum": ["accepted", "rejected"]},
          "disposition": {"enum": ["accepted", "rejected"]},
          "rationale_code": {"type": "string", "minLength": 1},
          "llm_invoked": {"const": false},
          "vision_invoked": {"const": false}
        }
      }
    }
  }
}
