{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "handle": {"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string","pattern":"^/"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "identity": {"type":"object","additionalProperties":false,"required":["contract_id","policy_hash","producer_run_id","artifact_set_id"],"properties":{"contract_id":{"type":"string","pattern":"^[0-9a-f]{64}$"},"policy_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"producer_run_id":{"type":"integer","minimum":0},"artifact_set_id":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "rule": {"type":"object","additionalProperties":false,"required":["id","class","status"],"properties":{"id":{"type":"string","pattern":"^(AQ|FAX)-"},"class":{"enum":["deterministic","visual","semantic"]},"status":{"enum":["pass","fail","HARD_FAIL","REVIEW_CANDIDATE","NOT_VERIFIED","NOT_APPLICABLE"]},"evidence":{"$ref":"#/$defs/handle"},"disposition":{"enum":["evidence_validated","not_applicable","missing_evidence","invalid_evidence","rule_failed","missing_applicability","invalid_applicability"]},"binary":{"type":"object","additionalProperties":false,"required":["mode","threshold"],"properties":{"mode":{"const":"1-bit"},"threshold":{"type":"integer","minimum":0,"maximum":255}}}}}
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","created_at","status","contract","checker","rulesets","entries"],
  "properties": {
    "schema_version":{"const":"docs-artifact-quality-receipt-1"},
    "created_at":{"type":"string","format":"date-time"},
    "status":{"enum":["pass","block"]},
    "contract":{"$ref":"#/$defs/handle"},
    "checker":{"$ref":"#/$defs/handle"},
    "finalization":{"type":"object","additionalProperties":false,"required":["path","sha256","artifact_set_id"],"properties":{"path":{"type":"string","pattern":"^/"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"artifact_set_id":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "execution_contract":{"type":"object","additionalProperties":false,"required":["contract","producer_receipt","execution_identity"],"properties":{"contract":{"$ref":"#/$defs/handle"},"producer_receipt":{"$ref":"#/$defs/handle"},"execution_identity":{"$ref":"#/$defs/identity"}}},
    "artifact_quality":{"enum":["pass","block"]},
    "workflow_state":{"enum":["ready","review_required","blocked","offline_not_evaluated"]},
    "worker_return":{"type":"object"},
    "jev_evaluation":{"type":"object","required":["path","sha256","execution_mode"],"properties":{"path":{"type":"string","pattern":"^/"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"execution_mode":{"enum":["dry_run","live"]}}},
    "rulesets":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","path","sha256"],"properties":{"id":{"type":"string"},"path":{"type":"string","pattern":"^/"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}},
    "quality_layers":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["layer","rule_id","source_principle","measured","threshold_or_preset","status"],"properties":{"layer":{"enum":["L0","L1","L2","L3"]},"rule_id":{"pattern":"^L[0-3]-"},"source_principle":{"type":"string","minLength":1},"measured":{},"threshold_or_preset":{},"status":{"enum":["pass","block","review"]}}}},
    "entries":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["artifact","actual_delivery_readback","rules","status"],"properties":{"artifact":{"$ref":"#/$defs/handle"},"actual_delivery_readback":{"$ref":"#/$defs/handle"},"local_readback":{"$ref":"#/$defs/handle"},"global_readback":{"$ref":"#/$defs/handle"},"common_evidence":{"$ref":"#/$defs/handle"},"rules":{"type":"array","minItems":14,"items":{"$ref":"#/$defs/rule"}},"status":{"enum":["pass","block"]}}}}
  }
}
