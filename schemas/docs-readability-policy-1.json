{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rollout_mode", "required_evidence", "regions", "print_variants", "review_thresholds"],
  "properties": {
    "schema_version": {"const": "docs-readability-policy-1"},
    "rollout_mode": {"enum": ["shadow", "enforced"]},
    "required_evidence": {"type": "boolean"},
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["region_id", "role", "render_index", "bbox_norm", "foreground_hex", "foreground_tolerance", "min_contrast_ratio", "min_font_size_pt"],
        "properties": {
          "region_id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "render_index": {"type": "integer", "minimum": 1},
          "bbox_norm": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1}},
          "foreground_hex": {"type": "string", "pattern": "^#[0-9A-F]{6}$"},
          "foreground_tolerance": {"type": "number", "minimum": 0, "maximum": 255},
          "min_contrast_ratio": {"type": "number", "minimum": 1, "maximum": 21},
          "min_font_size_pt": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "print_variants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grayscale", "scales"],
      "properties": {
        "grayscale": {"const": true},
        "scales": {"type": "array", "minItems": 1, "uniqueItems": true, "contains": {"const": 1.0}, "items": {"type": "number", "minimum": 0.1, "maximum": 1.0}}
      }
    },
    "review_thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dominant_visual_max_ratio", "glow_competition_max_ratio"],
      "properties": {
        "dominant_visual_max_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "glow_competition_max_ratio": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
