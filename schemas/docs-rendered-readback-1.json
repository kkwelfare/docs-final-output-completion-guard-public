{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "handle": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes"], "properties": {"path": {"type": "string", "pattern": "^/"}, "sha256": {"$ref": "#/$defs/hash"}, "size_bytes": {"type": "integer", "minimum": 0}}},
    "identity": {"type": "object", "additionalProperties": false, "required": ["contract_id", "policy_hash", "producer_run_id", "artifact_set_id"], "properties": {"contract_id": {"$ref": "#/$defs/hash"}, "policy_hash": {"$ref": "#/$defs/hash"}, "producer_run_id": {"type": "integer", "minimum": 0}, "artifact_set_id": {"$ref": "#/$defs/hash"}}},
    "color_receipt": {"type": "object", "additionalProperties": false, "required": ["schema_version", "execution_identity", "status", "palette", "samples", "HARD_FAIL"], "properties": {"schema_version": {"const": "docs-rendered-color-receipt-1"}, "execution_identity": {"$ref": "#/$defs/identity"}, "status": {"enum": ["pass", "HARD_FAIL"]}, "palette": {"type": "object", "minProperties": 1}, "samples": {"type": "array", "items": {"type": "object"}}, "HARD_FAIL": {"type": "array", "items": {"type": "object"}}}},
    "readability_contrast": {"type": "object", "additionalProperties": false, "required": ["foreground_pixel_count", "background_sample_count", "min", "p05", "median"], "properties": {"foreground_pixel_count": {"type": "integer", "minimum": 1}, "background_sample_count": {"type": "integer", "minimum": 1}, "min": {"type": "number", "minimum": 1, "maximum": 21}, "p05": {"type": "number", "minimum": 1, "maximum": 21}, "median": {"type": "number", "minimum": 1, "maximum": 21}}},
    "readability_variant_measurement": {"type": "object", "additionalProperties": false, "required": ["region_id", "status", "reason", "contrast"], "properties": {"region_id": {"type": "string", "minLength": 1}, "status": {"enum": ["pass", "HARD_FAIL", "NOT_VERIFIED"]}, "reason": {"type": ["string", "null"]}, "contrast": {"anyOf": [{"$ref": "#/$defs/readability_contrast"}, {"type": "null"}]}}},
    "readability_variant": {"type": "object", "additionalProperties": false, "required": ["kind", "scale", "path", "sha256", "width", "height", "pixel_sha256", "render_index", "measurements"], "properties": {"kind": {"enum": ["native", "grayscale", "scale"]}, "scale": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "path": {"type": "string", "pattern": "^/"}, "sha256": {"$ref": "#/$defs/hash"}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}, "pixel_sha256": {"$ref": "#/$defs/hash"}, "render_index": {"type": "integer", "minimum": 1}, "measurements": {"type": "array", "items": {"$ref": "#/$defs/readability_variant_measurement"}}}},
    "readability_receipt": {"type": "object", "required": ["schema_version", "execution_identity", "policy_hash", "rollout_mode", "required_evidence", "artifact_path", "artifact_sha256", "outcomes", "regions", "variants", "HARD_FAIL", "NOT_VERIFIED", "REVIEW_CANDIDATE", "review_disposition", "model_invoked_on_hard_fail_path"], "properties": {"schema_version": {"const": "docs-rendered-readability-receipt-1"}, "execution_identity": {"$ref": "#/$defs/identity"}, "policy_hash": {"$ref": "#/$defs/hash"}, "rollout_mode": {"enum": ["shadow", "enforced"]}, "required_evidence": {"type": "boolean"}, "artifact_path": {"type": "string", "pattern": "^/"}, "artifact_sha256": {"$ref": "#/$defs/hash"}, "outcomes": {"type": "array", "minItems": 5, "maxItems": 5}, "regions": {"type": "array"}, "variants": {"type": "array", "items": {"$ref": "#/$defs/readability_variant"}}, "HARD_FAIL": {"type": "array"}, "NOT_VERIFIED": {"type": "array"}, "REVIEW_CANDIDATE": {"type": "array"}, "review_disposition": {"type": ["object", "null"]}, "model_invoked_on_hard_fail_path": {"const": false}}},
    "surface_bbox": {"anyOf": [{"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}], "minItems": 4, "maxItems": 4}, {"type": "null"}]},
    "surface_fact": {"type": "object", "additionalProperties": false, "required": ["region_id", "page_index", "shape_id", "bbox_pt", "surface_present", "relative_strength", "status"], "properties": {"region_id": {"type": "string", "minLength": 1}, "page_index": {"type": "integer", "minimum": 0}, "shape_id": {"type": ["string", "null"]}, "bbox_pt": {"$ref": "#/$defs/surface_bbox"}, "surface_present": {"type": "boolean"}, "relative_strength": {"anyOf": [{"type": "object", "additionalProperties": false, "required": ["mean_luminance", "page_mean_luminance", "absolute_luminance_delta", "normalized_pixel_variance"], "properties": {"mean_luminance": {"type": "number", "minimum": 0, "maximum": 1}, "page_mean_luminance": {"type": "number", "minimum": 0, "maximum": 1}, "absolute_luminance_delta": {"type": "number", "minimum": 0, "maximum": 1}, "normalized_pixel_variance": {"type": "number", "minimum": 0, "maximum": 1}}}, {"type": "null"}]}, "status": {"enum": ["pass", "review"]}}},
    "surface_issue": {"type": "object", "required": ["rule_id"], "properties": {"rule_id": {"enum": ["SURFACE-IDENTITY-01", "SURFACE-HASH-01", "SURFACE-SCHEMA-01", "SURFACE-CONTAINMENT-01", "SURFACE-GEOMETRY-01"]}}, "additionalProperties": true},
    "surface_candidate": {"type": "object", "additionalProperties": false, "required": ["id", "rule", "region_id", "page", "shape_ids", "bbox_pdf_points"], "properties": {"id": {"type": "string", "pattern": "^surface-"}, "rule": {"enum": ["semantic_surface_mapping_unavailable", "semantic_surface_relative_strength_ambiguous"]}, "region_id": {"type": "string", "minLength": 1}, "page": {"type": ["integer", "null"], "minimum": 1}, "shape_ids": {"type": "array", "items": {"type": "string"}}, "bbox_pdf_points": {"$ref": "#/$defs/surface_bbox"}}},
    "surface_readback": {"type": "object", "additionalProperties": false, "required": ["schema_version", "artifact_path", "artifact_sha256", "execution_identity", "source_evidence", "surface_presence_count", "facts", "HARD_FAIL", "REVIEW_CANDIDATE", "status"], "properties": {"schema_version": {"const": "docs-rendered-semantic-surface-readback-1"}, "artifact_path": {"type": "string", "pattern": "^/"}, "artifact_sha256": {"$ref": "#/$defs/hash"}, "execution_identity": {"$ref": "#/$defs/identity"}, "source_evidence": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^/"}, "sha256": {"$ref": "#/$defs/hash"}}}, "surface_presence_count": {"type": "integer", "minimum": 0}, "facts": {"type": "array", "items": {"$ref": "#/$defs/surface_fact"}}, "HARD_FAIL": {"type": "array", "items": {"$ref": "#/$defs/surface_issue"}}, "REVIEW_CANDIDATE": {"type": "array", "items": {"$ref": "#/$defs/surface_candidate"}}, "status": {"enum": ["pass", "REVIEW_CANDIDATE", "HARD_FAIL"]}}},
    "geometry_primitive_mapping": {"type": "object", "additionalProperties": false, "required": ["primitive_id", "member_id", "page", "bbox_pdf_points", "crop_sha256"], "properties": {"primitive_id": {"type": "string", "minLength": 1}, "member_id": {"type": "string", "minLength": 1}, "page": {"type": "integer", "minimum": 1}, "bbox_pdf_points": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}], "minItems": 4, "maxItems": 4}, "crop_sha256": {"$ref": "#/$defs/hash"}}},
    "relative_anchor_gap_effective": {"type": "object", "additionalProperties": true, "required": ["measurement_basis", "tail_tip_pdf_points", "avatar_bbox_pdf_points", "avatar_width_pt", "direction_vector", "gap_pt", "gap_ratio", "target_gap_ratio", "tolerance", "facing", "no_contact", "contact_distance_pt", "status", "failed_constraints", "artifact_path", "artifact_sha256"], "properties": {"measurement_basis": {"enum": ["pdf_render_mask", "png_alpha_mask"]}, "tail_tip_pdf_points": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}, "avatar_bbox_pdf_points": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}, "avatar_width_pt": {"type": "number", "exclusiveMinimum": 0}, "direction_vector": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}, "gap_pt": {"type": "number"}, "gap_ratio": {"type": "number"}, "target_gap_ratio": {"type": "number"}, "tolerance": {"type": "number"}, "facing": {"enum": ["toward_anchor", "away_from_anchor", "neutral"]}, "no_contact": {"type": "boolean"}, "contact_distance_pt": {"type": "number", "minimum": 0}, "status": {"const": "pass"}, "failed_constraints": {"type": "array", "maxItems": 0}, "artifact_path": {"type": "string", "pattern": "^/"}, "artifact_sha256": {"$ref": "#/$defs/hash"}}},
    "relative_anchor_gap_readback": {"type": "object", "additionalProperties": false, "required": ["evidence", "annotation_id", "format", "effective"], "properties": {"evidence": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^/"}, "sha256": {"$ref": "#/$defs/hash"}}}, "annotation_id": {"type": "string", "minLength": 1}, "format": {"enum": ["pdf", "png"]}, "effective": {"$ref": "#/$defs/relative_anchor_gap_effective"}}},
    "geometry_relation": {"type": "object", "additionalProperties": false, "required": ["relation_id", "type", "format", "adapter", "source_order_pass", "source_evidence_sha256", "measurement_basis", "status", "evidence_sha256", "primitive_mappings"], "properties": {"relation_id": {"type": "string", "minLength": 1}, "type": {"enum": ["anchor_gap", "connector_route", "layer_relation", "content_inset"]}, "format": {"enum": ["html", "pptx", "svg"]}, "adapter": {"type": "string", "minLength": 1}, "source_order_pass": {"type": "boolean"}, "source_evidence_sha256": {"$ref": "#/$defs/hash"}, "measurement_basis": {"enum": ["pdf_vector", "pdf_vector_plus_render_mask", "pdf_render_mask", "png_alpha_mask", "unavailable"]}, "status": {"enum": ["measured", "ambiguous"]}, "evidence_sha256": {"$ref": "#/$defs/hash"}, "primitive_mappings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/geometry_primitive_mapping"}}, "relative_anchor_gap": {"$ref": "#/$defs/relative_anchor_gap_readback"}}},
    "geometry_relation_readback": {"type": "object", "additionalProperties": false, "required": ["schema_version", "artifact_path", "artifact_sha256", "execution_identity", "content_block_evidence", "relation_count", "relations"], "properties": {"schema_version": {"const": "docs-rendered-geometry-relation-readback-1"}, "artifact_path": {"type": "string", "pattern": "^/"}, "artifact_sha256": {"$ref": "#/$defs/hash"}, "execution_identity": {"$ref": "#/$defs/identity"}, "content_block_evidence": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^/"}, "sha256": {"$ref": "#/$defs/hash"}}}, "relation_count": {"type": "integer", "minimum": 1}, "relations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/geometry_relation"}}}}
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_path", "artifact_sha256", "artifact_type", "renderer", "renders"],
  "properties": {
    "schema_version": {"const": "docs-rendered-readback-1"},
    "artifact_path": {"type": "string", "pattern": "^/"},
    "artifact_sha256": {"$ref": "#/$defs/hash"},
    "artifact_type": {"type": "string", "minLength": 1},
    "producer_run_id": {"type": "integer", "minimum": 0},
    "artifact_set_id": {"$ref": "#/$defs/hash"},
    "execution_identity": {"$ref": "#/$defs/identity"},
    "execution_contract": {"$ref": "#/$defs/handle"},
    "producer_receipt": {"$ref": "#/$defs/handle"},
    "color_receipt": {"$ref": "#/$defs/color_receipt"},
    "readability_receipt": {"$ref": "#/$defs/readability_receipt"},
    "surface_readback": {"$ref": "#/$defs/surface_readback"},
    "geometry_relation_readback": {"$ref": "#/$defs/geometry_relation_readback"},
    "renderer": {"type": "object", "additionalProperties": false, "properties": {"checker_id": {"type": "string", "minLength": 1}, "reviewer_id": {"type": "string", "minLength": 1}}, "anyOf": [{"required": ["checker_id"]}, {"required": ["reviewer_id"]}]},
    "renders": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "width", "height", "pixel_sha256"], "properties": {"path": {"type": "string", "pattern": "^/"}, "sha256": {"$ref": "#/$defs/hash"}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}, "pixel_sha256": {"$ref": "#/$defs/hash"}, "page": {"type": "integer", "minimum": 1}}}}
  },
  "allOf": [
    {"if": {"allOf": [{"required": ["execution_identity"]}, {"not": {"required": ["geometry_relation_readback"]}}]}, "then": {"required": ["execution_contract", "producer_receipt", "producer_run_id", "artifact_set_id"]}},
    {"if": {"anyOf": [{"required": ["execution_contract"]}, {"required": ["producer_receipt"]}, {"required": ["color_receipt"]}, {"required": ["readability_receipt"]}, {"required": ["surface_readback"]}]}, "then": {"required": ["execution_identity", "execution_contract", "producer_receipt", "producer_run_id", "artifact_set_id"]}},
    {"if": {"required": ["geometry_relation_readback"]}, "then": {"required": ["execution_identity", "producer_run_id", "artifact_set_id"]}}
  ]
}
