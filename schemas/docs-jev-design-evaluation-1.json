{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "docs-jev-design-evaluation-1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "category": {
      "enum": [
        "information_priority",
        "readability_proxies",
        "visual_hierarchy_structure",
        "claim_support",
        "comparison_semantics",
        "connector_meaning",
        "misinterpretation_risk"
      ]
    },
    "choice": {
      "enum": ["intended", "acceptable", "repair_required", "insufficient_information"]
    },
    "branch": {
      "enum": ["maintain", "adjust", "request_information", "unresolved"]
    },
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["categories"],
      "properties": {
        "schema_version": {"const": "docs-jev-design-intent-1"},
        "intent_id": {"$ref": "#/$defs/id"},
        "categories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/category"}},
        "priority_order": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "element_roles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "role"],
            "properties": {"id": {"$ref": "#/$defs/id"}, "role": {"type": "string", "minLength": 1, "maxLength": 64}}
          }
        },
        "claims": {"type": "array", "items": {"$ref": "#/$defs/structural_relation"}},
        "claim_support": {"type": "array", "items": {"$ref": "#/$defs/structural_relation"}},
        "comparisons": {"type": "array", "items": {"$ref": "#/$defs/structural_relation"}},
        "connectors": {"type": "array", "items": {"$ref": "#/$defs/structural_relation"}},
        "relations": {"type": "array", "items": {"$ref": "#/$defs/structural_relation"}},
        "risk_tolerance": {"enum": ["low", "medium", "high"]}
      }
    },
    "structural_relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "source_id": {"$ref": "#/$defs/id"},
        "target_id": {"$ref": "#/$defs/id"},
        "target_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "from_id": {"$ref": "#/$defs/id"},
        "to_id": {"$ref": "#/$defs/id"},
        "to_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "left_id": {"$ref": "#/$defs/id"},
        "right_id": {"$ref": "#/$defs/id"},
        "support_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "relation_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "kind": {"type": "string", "minLength": 1, "maxLength": 64},
        "type": {"type": "string", "minLength": 1, "maxLength": 64},
        "role": {"type": "string", "minLength": 1, "maxLength": 64},
        "meaning": {"type": "string", "minLength": 1, "maxLength": 64},
        "axis": {"type": "string", "minLength": 1, "maxLength": 64},
        "relation": {"type": "string", "minLength": 1, "maxLength": 64},
        "claim_kind": {"type": "string", "minLength": 1, "maxLength": 64},
        "risk_kind": {"type": "string", "minLength": 1, "maxLength": 64},
        "severity": {"enum": ["low", "medium", "high"]},
        "priority_rank": {"type": "integer", "minimum": 0},
        "level": {"type": "integer", "minimum": 0},
        "weight": {"type": "number", "minimum": 0},
        "score": {"type": "number"},
        "ratio": {"type": "number", "minimum": 0},
        "declared": {"type": "boolean"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "docs-jev-design-evaluation-1"},
    "enabled": {"type": "boolean"},
    "model": {"type": "string", "minLength": 1, "maxLength": 128},
    "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 120},
    "max_candidates": {"type": "integer", "minimum": 1, "maximum": 64},
    "provider_mode": {"const": "typesafe_then_openrouter"},
    "allow_live_provider": {"type": "boolean"},
    "execution_mode": {"enum": ["dry_run", "live"]},
    "request_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "expected_count"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "expected_count": {"type": "integer", "minimum": 1, "maximum": 64},
        "count": {"type": "integer", "minimum": 1, "maximum": 64}
      }
    },
    "categories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/category"}},
    "design_intent": {"$ref": "#/$defs/intent"}
  },
  "allOf": [
    {
      "if": {"properties": {"enabled": {"const": true}}},
      "then": {"required": ["enabled", "categories", "design_intent"]}
    }
  ]
}
