{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fileHandle": {"type": "object", "additionalProperties": false, "required": ["canonical_path", "sha256", "size_bytes"], "properties": {"canonical_path": {"type": "string", "pattern": "^/"}, "sha256": {"$ref": "#/$defs/hash"}, "size_bytes": {"type": "integer", "minimum": 0}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["canonical_path", "sha256", "size_bytes", "media_type"], "properties": {"canonical_path": {"type": "string", "pattern": "^/"}, "sha256": {"$ref": "#/$defs/hash"}, "size_bytes": {"type": "integer", "minimum": 0}, "media_type": {"type": "string", "minLength": 1}}},
    "identity": {"type": "object", "additionalProperties": false, "required": ["contract_id", "policy_hash", "producer_run_id", "artifact_set_id"], "properties": {"contract_id": {"$ref": "#/$defs/hash"}, "policy_hash": {"$ref": "#/$defs/hash"}, "producer_run_id": {"type": "integer", "minimum": 0}, "artifact_set_id": {"$ref": "#/$defs/hash"}}}
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "state", "artifacts", "artifact_set_id"],
  "properties": {
    "schema_version": {"const": "docs-finalization-manifest-1"},
    "state": {"enum": ["finalizing", "checked", "reviewed", "accepted"]},
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "artifact_set_id": {"$ref": "#/$defs/hash"},
    "source": {"$ref": "#/$defs/fileHandle"},
    "checker": {"$ref": "#/$defs/fileHandle"},
    "created_by_task_id": {"type": "string", "minLength": 1},
    "created_by_run_id": {"type": "integer", "minimum": 0},
    "execution_identity": {"$ref": "#/$defs/identity"},
    "execution_contract": {"$ref": "#/$defs/fileHandle"},
    "producer_receipt": {"$ref": "#/$defs/fileHandle"},
    "renderer_receipts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fileHandle"}}
  },
  "allOf": [{"if": {"required": ["execution_identity"]}, "then": {"required": ["execution_contract", "producer_receipt", "renderer_receipts", "created_by_run_id"]}}]
}
