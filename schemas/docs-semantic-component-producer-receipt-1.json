{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "docs-semantic-component-producer-receipt-1.json",
  "title": "Semantic component producer receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "execution_identity", "policy_digest", "frame_count", "ir", "artifacts"],
  "properties": {
    "schema_version": {"const": "docs-semantic-component-producer-receipt-1"},
    "status": {"const": "pass"},
    "execution_identity": {"$ref": "#/$defs/identity"},
    "policy_digest": {"$ref": "#/$defs/hash"},
    "frame_count": {"type": "integer", "minimum": 1},
    "ir": {"$ref": "#/$defs/ir"},
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/handle"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_id", "policy_hash", "producer_run_id", "artifact_set_id"],
      "properties": {"contract_id": {"$ref": "#/$defs/hash"}, "policy_hash": {"$ref": "#/$defs/hash"}, "producer_run_id": {"type": "integer", "minimum": 0}, "artifact_set_id": {"$ref": "#/$defs/hash"}}
    },
    "handle": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes"],
      "properties": {"path": {"type": "string", "pattern": "^/"}, "sha256": {"$ref": "#/$defs/hash"}, "size_bytes": {"type": "integer", "minimum": 1}}
    },
    "ir": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "execution_identity", "component_count", "relation_count", "components", "relations", "status"],
      "properties": {
        "schema_version": {"const": "docs-semantic-component-ir-1"}, "execution_identity": {"$ref": "#/$defs/identity"},
        "component_count": {"type": "integer", "minimum": 1}, "relation_count": {"type": "integer", "minimum": 0},
        "components": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "relations": {"type": "array", "items": {"type": "object"}},
        "boundary_no_contact": {"$ref": "#/$defs/boundary_no_contact"},
        "status": {"const": "pass"}
      }
    },
    "boundary_no_contact": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "status", "source_artifact", "rendered_artifact", "page_indexes", "violation_count", "duplicate_candidate_count"],
      "properties": {
        "schema_version": {"const": "docs-semantic-component-boundary-no-contact-evidence-1"},
        "status": {"const": "pass"},
        "source_artifact": {"$ref": "#/$defs/handle"},
        "rendered_artifact": {"$ref": "#/$defs/handle"},
        "page_indexes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "violation_count": {"const": 0},
        "duplicate_candidate_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
