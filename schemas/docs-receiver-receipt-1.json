{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "artifact_set_id", "receiver_task_id", "receiver_run_id", "copies"],
  "properties": {
    "status": {"const": "accepted"},
    "artifact_set_id": {"$ref": "#/$defs/hash"},
    "receiver_task_id": {"type": "string", "minLength": 1},
    "receiver_run_id": {"type": "integer", "minimum": 0},
    "copies": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["canonical_path", "copy_path", "sha256", "size_bytes", "media_type"],
        "properties": {
          "canonical_path": {"type": "string", "pattern": "^/"},
          "copy_path": {"type": "string", "pattern": "^/"},
          "sha256": {"$ref": "#/$defs/hash"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "media_type": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
